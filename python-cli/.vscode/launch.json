{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    },
    {
      "name": "CLI: pick args",
      "type": "debugpy",
      "request": "launch",
      "module": "python_cli",
      "args": "${command:pickArgs}",
      "env": {
        "EXPENSES_FILE": "/tmp/expenses-practice.json"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CLI: import sample.csv",
      "type": "debugpy",
      "request": "launch",
      "module": "python_cli",
      "args": [
        "import",
        "sample.csv"
      ],
      "env": {
        "EXPENSES_FILE": "/tmp/expenses-practice.json"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}